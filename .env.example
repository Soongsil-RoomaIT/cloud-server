HOST=127.0.0.1
PORT=8081
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Empty in local demo: in-memory storage, cleared when restarted.
# For compose.yaml local services, use the values below and DEMO_MODE=false.
# DATABASE_URL=postgresql://roomait:local-development-only@localhost:5432/roomait
DATABASE_URL=
# MQTT_URL=mqtt://localhost:1883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=roomcare/room-001
# Existing team edge_agent protocol. roomait-v1 requires the documented richer ACK contract.
MQTT_PROTOCOL=edge-agent
EDGE_TIMEOUT_MS=10000
COMMAND_TIMEOUT_MS=5000

# Optional local test token. Production needs real login + HTTPS before public use.
API_BEARER_TOKEN=
# D backend/minjae Keycloak JWT. Allow only subjects belonging to this single room.
JWT_ISSUER_URI=
JWT_JWK_SET_URI=
JWT_AUDIENCE=room-care-api
ROOM_ALLOWED_SUBJECTS=
# Optional Gateway notification bridge in live mode.
# GATEWAY_INTERNAL_NOTIFICATIONS_URL=http://gateway-service:8080/internal/notifications
GATEWAY_INTERNAL_NOTIFICATIONS_URL=
INTERNAL_API_KEY=
# Public data portal: use the decoded service key. Keep it server-side.
KMA_SERVICE_KEY=
KMA_NX=60
KMA_NY=127
# AirKorea decoded service key and the station serving this room.
AIRKOREA_SERVICE_KEY=
AIRKOREA_STATION_NAME=
